---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { FolderTree } from '../../components/FolderTree';

export async function getStaticPaths() {
  const analyses = await getCollection('analyses');
  return analyses.map((analysis) => ({ params: { slug: analysis.slug }, props: { analysis } }));
}

const { analysis } = Astro.props;
const { Content, headings } = await render(analysis);

// Extract title from frontmatter or first heading
const title = analysis.data.title || (headings[0]?.text) || analysis.slug;
const { date, company, sector, tags } = analysis.data;

// Build tree from all analyses
const allAnalyses = await getCollection('analyses');
const withTitles = await Promise.all(
  allAnalyses.map(async (a) => {
    const { headings: h } = await render(a);
    const t = a.data.title || (h[0]?.text) || a.slug;
    return { ...a, data: { ...a.data, title: t } };
  })
);

// Build hierarchical tree from flat slugs
function buildTree(items: typeof withTitles) {
  const root: Record<string, any> = { children: [], name: '', path: '', type: 'folder' };

  const sorted = [...items].sort((a, b) => {
    const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
    const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
    return dateB - dateA;
  });

  for (const item of sorted) {
    const parts = item.slug.split('/');
    let current = root;
    let currentPath = '';

    for (let i = 0; i < parts.length; i++) {
      const part = parts[i];
      currentPath = currentPath ? `${currentPath}/${part}` : part;
      const isFile = i === parts.length - 1;

      let child = current.children.find((c: any) => c.path === currentPath);

      if (!child) {
        child = {
          name: isFile ? item.data.title : formatFolderName(part),
          path: currentPath,
          type: isFile ? 'file' : 'folder',
          slug: isFile ? item.slug : undefined,
          children: isFile ? undefined : [],
          tags: isFile ? item.data.tags : undefined,
        };
        current.children.push(child);
      } else if (isFile) {
        child.name = item.data.title;
        child.slug = item.slug;
        child.tags = item.data.tags;
      }
      current = child;
    }
  }

  function sortTree(node: any) {
    if (node.children) {
      node.children.sort((a: any, b: any) => {
        if (a.type !== b.type) return a.type === 'folder' ? -1 : 1;
        if (a.type === 'folder') return a.name.localeCompare(b.name);
        return 0;
      });
      node.children.forEach(sortTree);
    }
  }
  sortTree(root);

  return root.children;
}

function formatFolderName(name: string): string {
  return name
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
}

const tree = buildTree(withTitles);
---

<Layout title={title}>
  <div style="display: grid; grid-template-columns: 280px 1fr; min-height: 100vh; gap: 0;">
    <aside style="border-right: 1px solid var(--border); overflow-y: auto; position: sticky; top: 0; height: 100vh; background: var(--bg-elevated); display: flex; flex-direction: column;">
      <header style="padding: 1.5rem; border-bottom: 1px solid var(--border);">
        <h1 style="font-size: 1.25rem; margin: 0; border: none; padding: 0;">
          <a href="/" style="color: var(--text); text-decoration: none;">Investments</a>
        </h1>
      </header>
      <FolderTree items={tree} currentSlug={analysis.slug} client:load />
    </aside>
    <main style="padding: 2rem 3rem; max-width: 900px;">
      <header style="margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border);">
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1rem; font-size: 0.8rem;">
          {(company || sector) && (
            <span style="background: var(--accent); color: var(--bg); padding: 0.25rem 0.625rem; border-radius: 4px; font-weight: 500;">
              {company || sector}
            </span>
          )}
          {date && (
            <span style="color: var(--text-muted); align-self: center;">
              {new Date(date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            </span>
          )}
          {tags && tags.map(tag => (
            <span style="background: var(--bg-elevated); border: 1px solid var(--border); padding: 0.125rem 0.5rem; border-radius: 4px; color: var(--text-muted);">{tag}</span>
          ))}
        </div>
        <h1 style="margin: 0; font-size: 2.25rem; line-height: 1.2; border: none; padding: 0;">{title}</h1>
      </header>
      <article style="font-size: 1rem; line-height: 1.8;">
        <Content />
      </article>
      <footer style="margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; flex-wrap: gap: 1rem;">
        <a href="/" style="color: var(--text-muted); font-size: 0.875rem;">← Back to all analyses</a>
        <a href={`https://github.com/sergiotorreslozano/investments/blob/main/analysis/${analysis.slug}.md`} target="_blank" rel="noopener" style="color: var(--text-muted); font-size: 0.875rem;">View source →</a>
      </footer>
    </main>
  </div>
</Layout>